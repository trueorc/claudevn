# ============================================
# ClaudeVN Remote Compute Instance - Configuration Template
# ============================================
# This environment file is for standalone compute instances that connect
# to a remote ClaudeVN Serving instance (not running locally).
#
# Setup:
#   1. Copy this file: cp .env.compute.example .env.compute
#   2. Edit .env.compute and configure CLAUDEVN_SERVING_URL
#   3. Customize instance identity, capabilities, and resources
#   4. Start: docker compose -f docker-compose.compute.yml up -d
#
# Architecture:
#   Remote compute instances "phone home" to Serving. They register
#   themselves on startup and maintain a heartbeat connection.
#   No inbound connections to Serving are required - only outbound
#   HTTP(S) from the compute instance.
#
# Variable Naming:
#   Both CLAUDEVN_* and COMPUTE_* prefixes are supported for backwards
#   compatibility. Key equivalences:
#     CLAUDEVN_COMPUTE_ID    ↔ COMPUTE_INSTANCE_ID
#     CLAUDEVN_COMPUTE_NAME  ↔ COMPUTE_INSTANCE_NAME
#     CLAUDEVN_SKILLS        ↔ COMPUTE_SKILLS
#     CLAUDEVN_CAPABILITIES  ↔ COMPUTE_CAPABILITIES
#     CLAUDEVN_SERVING_URL   ↔ SERVING_URL

# ============================================
# Required: Remote Serving Instance
# ============================================
# URL of the ClaudeVN Serving instance to connect to
# This should be the full HTTP(S) URL including port if non-standard
#
# Production (with Caddy TLS - see deploy/cloud/):
#   CLAUDEVN_SERVING_URL=https://claudevn.example.com
#
# Local development:
#   CLAUDEVN_SERVING_URL=http://192.168.1.100:8002
#   CLAUDEVN_SERVING_URL=http://serving.local:8002
#
# WARNING: Using plain HTTP in production exposes API keys and credentials
# in transit. Always use HTTPS for internet-facing deployments.
CLAUDEVN_SERVING_URL=https://your-serving-domain.example.com

# Authentication endpoint (derived from SERVING_URL if not set)
# Usually you can leave this commented and it will auto-configure
#CLAUDEVN_SERVING_AUTH_URL=https://your-serving-domain.example.com/api/v1/auth

# ============================================
# Instance Identity
# ============================================
# Unique identifier for this compute instance
# Must be unique across all compute instances in your ClaudeVN cluster
CLAUDEVN_COMPUTE_ID=compute-remote-001

# Human-readable name for this instance
# Shown in the Serving UI and logs
CLAUDEVN_COMPUTE_NAME=Remote-Compute

# Public URL where this instance can be reached (optional, informational only)
#CLAUDEVN_COMPUTE_PUBLIC_URL=http://your-host-ip

# ============================================
# Registration Authentication
# ============================================
# Pre-shared token for registering with Serving via SSE.
# Must match COMPUTE_REGISTRATION_TOKEN configured on the Serving instance.
# Not required for local dev (when Serving has no token set).
#CLAUDEVN_API_KEY=troc_your_registration_token_here

# ============================================
# Authentication Mode
# ============================================
# How this compute instance authenticates with Claude API:
#   serving  - Fetch credentials from remote Serving instance (default)
#              Serving manages Claude OAuth and shares tokens
#   external - Use own Claude credentials (mount volume or configure separately)
#              You manage your own Claude authentication
COMPUTE_AUTH_MODE=serving

# ============================================
# Skills and Capabilities
# ============================================
# Skills: High-level role tags for work assignment (comma-separated)
# Examples: code-writer, debugger, doc-writer, test-automator, security-reviewer
CLAUDEVN_SKILLS=code-writer,test-automator

# Capabilities: Technical capabilities advertised to Serving (comma-separated)
# Examples: python, javascript, typescript, rust, debugging, security, documentation, markdown
CLAUDEVN_CAPABILITIES=coding,testing,documentation

# ============================================
# Resource Limits
# ============================================
# CPU cores available (advertised to Serving for work assignment)
CLAUDEVN_RESOURCES_CPU=4

# Memory available (advertised to Serving for work assignment)
# Units: gb, mb (e.g., 16gb, 8192mb)
CLAUDEVN_RESOURCES_MEMORY=16gb

# ============================================
# Network Configuration
# ============================================
# No port needed — compute has no HTTP server.
# It connects outbound to Serving via SSE.

# Heartbeat interval (seconds)
# How often to send health status to Serving
COMPUTE_HEARTBEAT_INTERVAL=30

# ============================================
# Logging
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# TLS Configuration
# ============================================
# Verify TLS certificates when connecting to Serving over HTTPS.
# Set to false ONLY for local development with self-signed certs (e.g., Caddy).
# In production with real certificates (Let's Encrypt, etc.), leave as true.
#TLS_VERIFY=true

# ============================================
# Advanced Configuration
# ============================================
# Enable MCP (Model Context Protocol) for communication with Serving
# Leave as true unless debugging
#MCP_ENABLED=true

# Storage path inside container (usually no need to change)
#COMPUTE_STORAGE_PATH=/app/data/compute
#COMPUTE_LOG_FILE=/app/logs/compute.log

# ============================================
# Notes
# ============================================
#
# Network Requirements:
#   - Outbound HTTP(S) access to CLAUDEVN_SERVING_URL
#   - Outbound SSH access to Serving Git server (port 2222)
#   - No inbound connections required
#
# Multiple Instances:
#   To run multiple compute instances on the same host:
#   1. Create separate .env.compute files (.env.compute.1, .env.compute.2, etc.)
#   2. Change CLAUDEVN_COMPUTE_ID for each instance
#   3. Copy and modify docker-compose.compute.yml with unique service/container names
#   4. Start each with: docker compose -f docker-compose.compute.yml up -d
#
# Security:
#   - Never commit .env.compute with real Serving URLs or credentials
#   - Use TLS (HTTPS) for production — see deploy/cloud/ for Caddy setup
#   - Consider VPN or private network for Serving access
#
# Troubleshooting:
#   - Check network connectivity: curl $CLAUDEVN_SERVING_URL/api/v1/health
#   - Check logs: docker compose -f docker-compose.compute.yml logs -f
#   - Verify registration: Check Serving UI at $CLAUDEVN_SERVING_URL
#   - Test SSH Git access: ssh -p 2222 git@<serving-host>
#
