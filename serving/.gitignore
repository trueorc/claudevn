# Serving Component .gitignore

# Database
*.db
*.sqlite
*.sqlite3
data/

# Blob storage
blobs/
storage/

# Environment
.env
.env.local

# Logs
*.log
logs/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Frontend (if enabled)
frontend/node_modules/
frontend/build/
frontend/dist/

# Session data (but not source code)
/sessions/
data/sessions/

