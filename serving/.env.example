# ===========================================
# ClaudeVN Serving Component - Environment Variables
# ===========================================

# -----------------
# Server Settings
# -----------------
SERVING_HOST=0.0.0.0
SERVING_PORT=8002
API_VERSION=v1
LOG_LEVEL=INFO

# CORS Configuration
# Use '*' for all origins or comma-separated list: 'http://localhost:3000,http://localhost:8001'
CORS_ORIGINS=*

# -----------------
# Storage Settings
# -----------------
# Base storage path for all data
STORAGE_PATH=./data/serving

# Cache storage (defaults to STORAGE_PATH/cache if not set)
CACHE_PATH=./data/serving/cache

# Data provider storage (defaults to STORAGE_PATH/datastore if not set)
DATASTORE_PATH=./data/serving/datastore

# Cache default TTL in seconds
CACHE_DEFAULT_TTL=300

# -----------------
# Health Monitoring
# -----------------
# How often to check health (seconds)
HEALTH_CHECK_INTERVAL=30

# Seconds before marking instance as degraded
DEGRADED_THRESHOLD=60

# Seconds before marking instance as offline
OFFLINE_THRESHOLD=90

# Max consecutive failed checks before auto-deregister
MAX_FAILED_CHECKS=3

# Automatically deregister instances after max failed checks
# Options: true, false
AUTO_DEREGISTER=false

# -----------------
# Session Management
# -----------------
# Enable session persistence to disk
# Options: true, false
SESSION_PERSISTENCE=true

# Session timeout in seconds
SESSION_TIMEOUT=3600

# -----------------
# Redis Configuration
# -----------------
# Redis is used for Git PR queue management
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=claudevn:

# -----------------
# Skill Marketplace (Embedded)
# -----------------
# Path to skill definitions (CLAUDE.md templates)
SKILLS_PATH=./marketplace/skills

# -----------------
# Git Infrastructure
# -----------------
# Path to bare Git repositories
GIT_REPOS_PATH=./data/repos

# Path to SSH authorized keys
GIT_SSH_KEYS_PATH=./data/ssh_keys

# Git user for SSH access
GIT_USER=git

# Enable SSH-based Git access
GIT_ENABLE_SSH=true

# Enable Redis notifications from Git hooks
GIT_HOOK_REDIS_NOTIFY=true

# -----------------
# SSE Configuration
# -----------------
# Keepalive interval in seconds (sent to compute instances to maintain connection)
# Default 15s is designed to survive NAT/firewall idle timeouts (typically 30-60s)
SSE_KEEPALIVE_INTERVAL=15

# -----------------
# Rate Limiting
# -----------------
# Enable/disable rate limiting
# NOTE: Rate limiting is automatically disabled in test environments
# (when PYTEST_CURRENT_TEST is set, TESTING=true, or pytest is imported).
# Set explicitly to override auto-detection.
RATE_LIMIT_ENABLED=true

# Default requests per minute for unspecified endpoints
RATE_LIMIT_DEFAULT_RPM=60

# Requests per minute for /compute/* endpoints (higher for compute instances)
RATE_LIMIT_COMPUTE_RPM=120

# Requests per minute for /work/* endpoints
RATE_LIMIT_WORK_RPM=60

# Requests per minute for /pr/* and /git/* endpoints
RATE_LIMIT_PR_RPM=30

# Burst multiplier (allows temporary bursts above rate limit)
# 1.5 means 50% burst capacity
RATE_LIMIT_BURST_MULTIPLIER=1.5

# -----------------
# Future: S3 Data Provider
# -----------------
# Uncomment when using S3 data provider
# AWS_REGION=us-west-2
# S3_BUCKET=claudevn-serving-data
# DATA_PROVIDER=s3

# -----------------
# Compute Registration Authentication
# -----------------
# Pre-shared token that compute instances must present to register via SSE.
# If not set, registration is open (suitable for local dev with Docker network).
# For production, generate a strong random token:
#   python -c "import secrets; print(f'troc_{secrets.token_hex(24)}')"
#COMPUTE_REGISTRATION_TOKEN=troc_your_token_here

# -----------------
# Authentication
# -----------------
# Auth mode: 'cognito' for production, 'local' for dev with users, 'bypass' for no auth
# - cognito: AWS Cognito JWT verification (production)
# - local: File-based credentials (dev/testing with multi-user collaboration)
# - bypass: No auth, all requests get a dev user identity
AUTH_MODE=bypass

# AWS Cognito User Pool settings (required when AUTH_MODE=cognito)
# These values come from the CloudFormation stack outputs (deploy/cloud/cognito-user-pool.yaml)
#COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
#COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
#COGNITO_REGION=us-east-1

# Enable admin user management endpoints (invite, list, remove users)
# Requires AWS credentials with cognito-idp:Admin* permissions
#COGNITO_ADMIN_ENABLED=false

# Local auth settings (required when AUTH_MODE=local)
# Path to credential file with username:password per line (plain text, dev only)
# WARNING: Local auth is NOT for production use.
#LOCAL_USERS_FILE=users.local

# -----------------
# Network Capacity
# -----------------
# Maximum number of compute instances allowed (0 = unlimited)
MAX_COMPUTE_INSTANCES=0
