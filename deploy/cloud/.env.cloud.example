# ClaudeVN Cloud Deployment - Environment Variables
#
# Copy this file: cp .env.cloud.example .env.cloud
# Then configure your domain.

# Required: Your public domain name
# A DNS A record must point this domain to your VM's public IP.
# Caddy will auto-provision a Let's Encrypt TLS certificate.
DOMAIN=claudevn.example.com

# Required: Registration token for compute instances
# Generate with: python -c "import secrets; print(f'troc_{secrets.token_hex(24)}')"
# Share this token with each compute instance (set as CLAUDEVN_API_KEY).
COMPUTE_REGISTRATION_TOKEN=troc_CHANGE_ME
