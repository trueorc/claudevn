# ============================================
# ClaudeVN Platform - Configuration Template
# ============================================
# Copy this file to .env and customize for your environment
#
# For development: Use this single file in project root
# For production: Copy sections to component-specific .env files
#   - marketplace/.env
#   - serving/.env
#   - compute/.env

# ============================================
# General Settings
# ============================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================
# Marketplace Configuration (Port 8001)
# ============================================
MARKETPLACE_HOST=0.0.0.0
MARKETPLACE_PORT=8001

# Authentication (enabled by default; set to false for local dev only)
MARKETPLACE_REQUIRE_AUTH=false
#MARKETPLACE_API_KEY=your-default-api-key
#SERVING_API_KEY=your-serving-api-key
#ADMIN_API_KEY=your-admin-api-key

# Storage backend: filesystem, dynamodb, or s3
STORAGE_BACKEND=filesystem
STORAGE_PATH=./marketplace/data/marketplace

# For DynamoDB storage (optional)
#DYNAMODB_TABLE_PREFIX=claudevn
#AWS_REGION=us-west-2
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# Marketplace logging
MARKETPLACE_LOG_FILE=./logs/marketplace.log

# Marketplace Registration with Serving (optional)
# If you want the marketplace to register with a serving component on startup:
SERVING_URL=http://localhost:8002
AUTO_REGISTER_WITH_SERVING=true

# ============================================
# Serving Configuration (Port 8002)
# ============================================
SERVING_HOST=0.0.0.0
SERVING_PORT=8002

# Serving storage path
STORAGE_PATH=./serving/data/serving

# Health monitoring settings
HEALTH_CHECK_INTERVAL=30
DEGRADED_THRESHOLD=60
OFFLINE_THRESHOLD=90
MAX_FAILED_CHECKS=3
AUTO_DEREGISTER=false

# Component Registration Pattern
# NOTE: Serving uses a "phone home" registration architecture.
# - Marketplaces register themselves with Serving (not the reverse)
# - Compute instances register themselves with Serving (not the reverse)
# - Serving passively accepts registrations via API endpoints
# - No pre-configuration of marketplace/compute URLs needed in Serving
#
# Configure marketplace with: SERVING_URL + AUTO_REGISTER_WITH_SERVING=true
# Configure compute with: SERVING_URL + COMPUTE_REGISTER_ON_STARTUP=true
#
# See: docs/design/specifications/REGISTRATION_ARCHITECTURE.md

# Session management
SESSION_TIMEOUT=60
MAX_SESSIONS=100

# SSH Git Server (for compute Git access)
GIT_ENABLE_SSH=true
SSH_GIT_PORT=2222
SSH_GIT_HOST=localhost
#SSH_HOST_KEY_PATH=./data/ssh_keys/ssh_host_ed25519_key

# Serving logging
SERVING_LOG_FILE=./logs/serving.log

# ============================================
# Compute Configuration (Port 8003)
# ============================================
COMPUTE_HOST=0.0.0.0
COMPUTE_PORT=8003

# Instance identity (auto-generated if not set)
#COMPUTE_INSTANCE_ID=compute-dev-001
#COMPUTE_INSTANCE_NAME=Development Compute

# Serving integration
SERVING_URL=http://localhost:8002
COMPUTE_REGISTER_ON_STARTUP=true
COMPUTE_HEARTBEAT_INTERVAL=30

# Compute storage
COMPUTE_STORAGE_PATH=./compute/data

# Agent and tool directories (optional)
#COMPUTE_AGENTS_DIR=./compute/agents
#COMPUTE_TOOLS_DIR=./compute/tools

# LLM Provider API Keys
#OPENAI_API_KEY=sk-...
#ANTHROPIC_API_KEY=sk-ant-...

# Features
COMPUTE_ENABLE_GPU=false

# Compute logging
COMPUTE_LOG_FILE=./logs/compute.log

# ============================================
# Notes
# ============================================
# 
# Development Setup:
#   1. Copy this file: cp .env.example .env
#   2. Add your API keys
#   3. Run: ./start_all.sh
#
# Production Setup:
#   1. Create component-specific .env files:
#      - marketplace/.env (copy Marketplace section)
#      - serving/.env (copy Serving section)  
#      - compute/.env (copy Compute section)
#   2. Configure each component independently
#   3. Start each service separately or use orchestration
#
# Registration Architecture:
#   - Marketplaces "phone home" to Serving (configure SERVING_URL in marketplace)
#   - Compute instances "phone home" to Serving (configure SERVING_URL in compute)
#   - Serving accepts registrations passively (no outbound connections needed)
#   - This pattern works through firewalls and NAT
#
# Security:
#   - Never commit .env files with real credentials
#   - Use secrets management in production
#   - Restrict host binding when appropriate
#
