# ============================================
# ClaudeVN Remote Serving Hub - Configuration Template
# ============================================
# This environment file is for deploying the Serving hub with Cognito
# authentication enabled. Remote compute instances connect to this hub.
#
# Setup:
#   1. Copy this file: cp .env.serving.example .env.serving
#   2. Deploy a Cognito User Pool (see docs/guides/cognito-setup.md)
#   3. Fill in the Cognito values below
#   4. Generate a compute registration token
#   5. Start: docker compose -f docker-compose.serving.yml up -d
#
# Architecture:
#   This deploys Serving + Marketplace + Redis (no compute instances).
#   Remote compute instances connect using docker-compose.compute.yml
#   with a matching CLAUDEVN_API_KEY / COMPUTE_REGISTRATION_TOKEN.

# ============================================
# Required: AWS Cognito Configuration
# ============================================
# Deploy the Cognito User Pool first:
#   aws cloudformation deploy \
#     --template-file deploy/cloud/cognito-user-pool.yaml \
#     --stack-name claudevn-cognito-dev \
#     --parameter-overrides Environment=dev ServingUrl=http://localhost:8002
#
# Then retrieve outputs:
#   aws cloudformation describe-stacks \
#     --stack-name claudevn-cognito-dev \
#     --query 'Stacks[0].Outputs' --output table

# Cognito User Pool ID (e.g., us-east-1_AbCdEfGhI)
COGNITO_USER_POOL_ID=

# Cognito App Client ID (e.g., 6vth5p8rhbr3fjm4gos2npa0uu)
COGNITO_APP_CLIENT_ID=

# AWS Region where the User Pool is deployed
COGNITO_REGION=us-east-1

# ============================================
# User Management
# ============================================
# Enable admin user management endpoints (invite, list, remove users)
# Requires AWS credentials with cognito-idp:Admin* permissions
COGNITO_ADMIN_ENABLED=true

# ============================================
# Compute Registration Security
# ============================================
# Pre-shared token that compute instances must present to register.
# Generate one with:
#   python -c "import secrets; print(f'troc_{secrets.token_hex(24)}')"
#
# Remote compute instances must set CLAUDEVN_API_KEY to this same value
# in their .env.compute file.
COMPUTE_REGISTRATION_TOKEN=

# ============================================
# Network Capacity
# ============================================
# Maximum number of compute instances allowed (0 = unlimited)
MAX_COMPUTE_INSTANCES=0

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO

# ============================================
# Notes
# ============================================
#
# Creating the first user:
#   aws cognito-idp admin-create-user \
#     --user-pool-id <COGNITO_USER_POOL_ID> \
#     --username admin@example.com \
#     --user-attributes '[{"Name":"email","Value":"admin@example.com"},{"Name":"email_verified","Value":"true"}]' \
#     --desired-delivery-mediums EMAIL
#
# Security:
#   - Never commit .env.serving with real Cognito values
#   - Always set COMPUTE_REGISTRATION_TOKEN for remote networks
#   - Use HTTPS (Caddy TLS) for internet-facing deployments
#     See deploy/cloud/ for Caddy configuration
#
# Counterpart:
#   Remote compute instances use docker-compose.compute.yml + .env.compute
#   See .env.compute.example for compute-side configuration
