# ClaudeVN Docker Environment Variables
# Copy this file to .env for docker-compose usage

# =============================================================================
# LLM API KEYS (Required for Compute Service)
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
CORS_ORIGINS=*
API_VERSION=v1

# =============================================================================
# COMPUTE INSTANCE CONFIGURATION
# =============================================================================
INSTANCE_ID=compute-01
INSTANCE_NAME=Compute-Instance-01
ENABLE_GPU=false

# =============================================================================
# MARKETPLACE CONFIGURATION
# =============================================================================
# Marketplace will auto-register with serving if SERVING_URL is set
# SERVING_URL=http://localhost:8002
# AUTO_REGISTER_WITH_SERVING=true   # Default: true
# MARKETPLACE_ID=marketplace-custom  # Optional: custom marketplace ID
# MARKETPLACE_NAME=My Marketplace    # Optional: custom name
# MARKETPLACE_PRIORITY=1             # Optional: priority (lower = higher)

# =============================================================================
# NOTES
# =============================================================================
# - Most configuration is handled in docker-compose.yml
# - Only add environment variables here that you want to override
# - API keys should NEVER be committed to version control
# - For production, use Docker secrets or external secret management

